+/**
+ * covibe integration: host headlessly on a caller-owned room.
+ *
+ * OMP_COLLAB_RELAY/_ROOM/_KEY (key = base64url of key‖writeToken) let the
+ * orchestrator own a stable, enumerable link instead of minting or scraping one.
+ * Hosting is supervised because a host that goes away never comes back on its
+ * own: CollabSocket treats 4001/4004/4009/4029 as fatal (no reconnect), and the
+ * host also stops itself on a session switch — which happens seconds into a
+ * fresh session, when the first prompt creates the real session id. A one-shot
+ * start therefore loses the room for the rest of a multi-hour session. Since the
+ * room id and key are fixed by the orchestrator, re-hosting restores the very
+ * same link, so already-shared links and QR codes keep working.
+ */
+
+/** Reason the /collab stop and /leave commands pass to {@link CollabHost.stop}. */
+const USER_STOP_REASON = "host stopped";
+const AUTOSTART_POLL_MS = 2_000;
+const AUTOSTART_BACKOFF_BASE_MS = 1_000;
+const AUTOSTART_BACKOFF_MAX_MS = 30_000;
+/**
+ * How long the host may stay disconnected before the supervisor replaces it.
+ * CollabSocket's own backoff caps at 30s, so this leaves room for the ordinary
+ * reconnect to win before intervening.
+ */
+const AUTOSTART_DISCONNECT_GRACE_MS = 30_000;
+
+/** Set once the user explicitly stops hosting, disabling re-hosting. */
+let userStoppedHosting = false;
+
+export interface CollabAutostartConfig {
+	relayUrl: string;
+	webUrl: string;
+	preset?: { roomId: string; key: Uint8Array; writeToken: Uint8Array };
+}
+
+/**
+ * Read the autostart env and remove it from process.env. Consuming it matters:
+ * children inherit the environment, so a nested omp (or a worker daemon) would
+ * otherwise try to host the same room and the relay rejects one of them with
+ * 4009 — if the child wins the race, the real session is locked out.
+ */
+export function readCollabAutostartEnv(): CollabAutostartConfig | undefined {
+	const relayUrl = process.env.OMP_COLLAB_RELAY;
+	const webUrl = process.env.OMP_COLLAB_WEB ?? "";
+	const roomId = process.env.OMP_COLLAB_ROOM;
+	const keyB64 = process.env.OMP_COLLAB_KEY;
+	delete process.env.OMP_COLLAB_RELAY;
+	delete process.env.OMP_COLLAB_WEB;
+	delete process.env.OMP_COLLAB_ROOM;
+	delete process.env.OMP_COLLAB_KEY;
+	if (!relayUrl) return undefined;
+	let preset: CollabAutostartConfig["preset"];
+	if (roomId && keyB64) {
+		const secret = new Uint8Array(Buffer.from(keyB64, "base64url"));
+		if (secret.byteLength === ROOM_KEY_BYTES + WRITE_TOKEN_BYTES) {
+			preset = {
+				roomId,
+				key: secret.subarray(0, ROOM_KEY_BYTES),
+				writeToken: secret.subarray(ROOM_KEY_BYTES),
+			};
+		} else {
+			logger.warn("collab autostart: OMP_COLLAB_KEY has unexpected length", {
+				bytes: secret.byteLength,
+				want: ROOM_KEY_BYTES + WRITE_TOKEN_BYTES,
+			});
+		}
+	}
+	return { relayUrl, webUrl, preset };
+}
+
+/**
+ * Host on the configured room and keep hosting for the life of the process:
+ * whenever the host goes away without the user asking, start a new one on the
+ * same room. No-ops when no relay is configured.
+ */
+export async function superviseAutostartCollab(ctx: InteractiveModeContext): Promise<void> {
+	const cfg = readCollabAutostartEnv();
+	if (!cfg) return;
+	let attempt = 0;
+	let disconnectedMs = 0;
+	for (;;) {
+		if (userStoppedHosting) return;
+		// A host that is present but not connected is stale: the relay has since
+		// freed the room, so replace it rather than wait for a reconnect that is
+		// never coming. Dropping it here makes the start below re-host the same
+		// room, which keeps every shared link and QR code valid.
+		const current = ctx.collabHost;
+		if (current && !ctx.collabGuest) {
+			disconnectedMs = current.connected ? 0 : disconnectedMs + AUTOSTART_POLL_MS;
+			if (disconnectedMs >= AUTOSTART_DISCONNECT_GRACE_MS) {
+				logger.warn("collab autostart: host disconnected, re-hosting", {
+					room: cfg.preset?.roomId,
+					disconnectedMs,
+				});
+				disconnectedMs = 0;
+				// Never let a failing teardown end supervision. This runs with a
+				// socket that is already gone, so `bye` can throw — and the call
+				// site only logs, so the throw would strand the room for the rest
+				// of the process. Drop the reference either way: the start below
+				// re-hosts the same room, keeping shared links and QR codes valid.
+				try {
+					await current.stop("relay connection lost");
+				} catch (err) {
+					logger.warn("collab autostart: stopping stale host failed", {
+						error: String(err),
+						room: cfg.preset?.roomId,
+					});
+					ctx.collabHost = undefined;
+				}
+			}
+		}
+		// Joining someone else's session takes precedence over hosting ours.
+		if (!ctx.collabHost && !ctx.collabGuest) {
+			try {
+				const host = new CollabHost(ctx);
+				await host.start(cfg.relayUrl, cfg.webUrl, cfg.preset);
+				ctx.collabHost = host;
+				attempt = 0;
+				logger.info("collab autostart: hosting", { room: cfg.preset?.roomId, relay: cfg.relayUrl });
+			} catch (err) {
+				attempt++;
+				const delay = Math.min(AUTOSTART_BACKOFF_MAX_MS, AUTOSTART_BACKOFF_BASE_MS * 2 ** (attempt - 1));
+				logger.warn("collab autostart: host start failed, retrying", {
+					error: String(err),
+					attempt,
+					delayMs: delay,
+					room: cfg.preset?.roomId,
+				});
+				await Bun.sleep(delay);
+				continue;
+			}
+		}
+		await Bun.sleep(AUTOSTART_POLL_MS);
+	}
+}
